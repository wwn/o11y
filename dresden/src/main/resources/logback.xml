<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{correlationId}] [%X{useCase}] [%X{method}] [%X{status}] [%X{durationMs}ms] [%X{errorReason}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="ch.nickl.o11y" level="DEBUG" />
</configuration>
