# Normalise line endings so the repo is consistent across OSes.
* text=auto eol=lf

# Scripts that must keep their platform-native endings.
*.bat        text eol=crlf
*.cmd        text eol=crlf
gradlew      text eol=lf
*.sh         text eol=lf

# Binary assets Git must not touch.
*.jar        binary
*.zip        binary
*.png        binary
*.jpg        binary
*.ico        binary
